{
	"schemaVersion": 1,
	"id": "requestboard",
	"version": "${version}",
	"name": "RequestBoard",
	"description": "A shared notice board where players post announcements, services and harvest requests.",
	"authors": ["BboyCrow"],
	"contact": {
		"sources": "https://github.com/BboyCrow/requestBoard",
		"issues": "https://github.com/BboyCrow/requestBoard/issues"
	},
	"license": "MIT",
	"icon": "assets/requestboard/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.bboycrow.requestboard.RequestBoard"],
		"client": ["io.github.bboycrow.requestboard.client.RequestBoardClient"]
	},
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	}
}
